# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SIFALO PAY CONFIGURATION (Somalia Mobile Money & Card Gateway)
# Supports EVC Plus, ZAAD, Sahal, eDahab, Premier Wallet, Visa & Mastercard
SIFALO_API_KEY="sifalo_live_or_test_key"
SIFALO_MERCHANT_ID="sifalo_merchant_id"
SIFALO_WEBHOOK_SECRET="sifalo_webhook_secret_key"
SIFALO_ENVIRONMENT="sandbox" # or "production"

# STRIPE CONFIGURATION (International Cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# SUPABASE CONFIGURATION (PostgreSQL Database & Authentication)
